DIOPT_DB_HOST=127.0.0.1
DIOPT_DB_PORT=43306
DIOPT_DB_USER=diopt_reader
DIOPT_DB_PASSWORD=
DIOPT_DB_NAME=diopt
DIOPT_LOCAL_DB=true
DIOPT_DATASET_ID=
# Required: output of scripts/build_method_coverage.py for this dataset.
DIOPT_METHOD_COVERAGE=
DIOPT_PORT=43100
# Optional additional listener on this machine's private LAN address:
# DIOPT_LAN_IP=192.0.2.10
DIOPT_WEB_DIR=web/dist
# Remote databases only (set DIOPT_LOCAL_DB=false): CA bundle for verified TLS.
# DIOPT_DB_CA=
# Read by scripts/, not by the API:
# DIOPT_DATA_DIR=~/diopt-data
# DIOPT_API_BINARY=services/diopt-api/target/release/diopt-api
